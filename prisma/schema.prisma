// Schéma Prisma — Dashboard Cambiste V1
// Modèle de données : Users, Clients, Transactions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// Utilisateur (mono-utilisateur en V1)
// ─────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ─────────────────────────────────────────
// Client
// ─────────────────────────────────────────
model Client {
  id           String        @id @default(cuid())
  fullName     String        @map("full_name")
  nickname     String?
  phone        String?
  note         String?
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("clients")
}

// ─────────────────────────────────────────
// Transaction
// ─────────────────────────────────────────
model Transaction {
  id              String        @id @default(cuid())
  clientId        String        @map("client_id")
  operationType   OperationType @map("operation_type")

  // Montants — on stocke les deux devises + taux pour la traçabilité
  amountCfa       Float         @map("amount_cfa")
  amountNaira     Float         @map("amount_naira")
  exchangeRate    Float         @map("exchange_rate")

  note            String?
  transactionDate DateTime      @default(now()) @map("transaction_date")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  client          Client        @relation(fields: [clientId], references: [id])

  // Index pour les requêtes de dashboard (filtre par date fréquent)
  @@index([transactionDate])
  @@index([clientId])
  @@map("transactions")
}

// ─────────────────────────────────────────
// Enum type d'opération
// ─────────────────────────────────────────
enum OperationType {
  BUY_NAIRA  // Le cambiste achète des Naira (le client vend)
  SELL_NAIRA // Le cambiste vend des Naira (le client achète)
}
