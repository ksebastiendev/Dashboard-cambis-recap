# ─────────────────────────────────────────────────────────────
# Base de données PostgreSQL (Supabase)
# Copier l'URL de connexion depuis votre projet Supabase
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Note : encoder les caractères spéciaux du mot de passe (ex: @ -> %40)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD_ENCODED@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=1&pool_timeout=20"

# Connexion directe — Session Mode via pooler (port 5432, sans pgbouncer)
# Pour éviter le blocage ISP sur le port direct Supabase (db.xxx.supabase.co:5432)
DIRECT_URL="postgresql://postgres.PROJET_REF:MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ─────────────────────────────────────────────────────────────
# Session iron-session
# Générer une clé aléatoire forte : openssl rand -base64 32
# Minimum 32 caractères — ne jamais commiter
# ─────────────────────────────────────────────────────────────
SESSION_SECRET="REMPLACER_PAR_UNE_CLE_ALEATOIRE_DE_32_CARACTERES_MINIMUM"

# ─────────────────────────────────────────────────────────────
# URL publique de l'app
# Développement : http://localhost:3000
# Production    : https://votre-app.vercel.app
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Environnement
# ─────────────────────────────────────────────────────────────
NODE_ENV="development"
