# ─────────────────────────────────────────────────────────────
# Base de données PostgreSQL (Supabase)
# Copier l'URL de connexion depuis votre projet Supabase
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Note : encoder les caractères spéciaux du mot de passe (ex: @ -> %40)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD_ENCODED@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=1&pool_timeout=20"

# Connexion directe (migrations Prisma)
DIRECT_URL="postgresql://USER:PASSWORD_ENCODED@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# ─────────────────────────────────────────────────────────────
# Session iron-session
# Générer une clé aléatoire forte : openssl rand -base64 32
# Minimum 32 caractères
# ─────────────────────────────────────────────────────────────
SESSION_SECRET="REMPLACER_PAR_UNE_CLE_ALEATOIRE_DE_32_CARACTERES_MINIMUM"

# ─────────────────────────────────────────────────────────────
# Environnement
# ─────────────────────────────────────────────────────────────
NODE_ENV="development"
